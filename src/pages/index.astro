---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { heroStats, products, storeFeatures } from '../data/site';

const heroMosaic = products.slice(0, 4);
const featuredProducts = products.slice(0, 12);
const basePath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const aboutUrl = `${basePath}nosotros/`;
---

<Layout title="FrontEnd Store | Tienda moderna" description="FrontEnd Store renovada con Astro y Tailwind CSS.">
  <section class="grid gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
    <div class="space-y-8">
      <span class="pill">Colección 2026</span>

      <div class="space-y-6">
        <h1 class="max-w-3xl text-5xl font-black leading-[0.92] text-white sm:text-6xl lg:text-7xl">
          Ropa y accesorios para devs con una estética más premium
        </h1>
        <p class="section-copy max-w-2xl text-lg text-slate-300 sm:text-xl">
          La tienda pasó de un HTML estático básico a una experiencia más moderna con Astro y Tailwind CSS: más aire, mejor jerarquía, tarjetas con profundidad y una navegación clara.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="#catalogo" class="cta-primary">Explorar catálogo</a>
        <a href={aboutUrl} class="cta-secondary">Ver historia</a>
      </div>

      <div class="grid gap-3 sm:grid-cols-3">
        {heroStats.map((stat) => (
          <article class="glass-surface rounded-[1.5rem] p-5">
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-mint-300">{stat.label}</p>
            <p class="mt-2 font-display text-3xl font-black text-white">{stat.value}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="relative">
      <div class="absolute inset-0 -rotate-6 rounded-[2.5rem] bg-gradient-to-br from-mint-400/20 via-white/5 to-sun-400/15 blur-3xl"></div>
      <div class="relative grid gap-4 rounded-[2rem] border border-white/10 bg-white/5 p-4 shadow-glow backdrop-blur-2xl sm:grid-cols-2">
        <div class="relative overflow-hidden rounded-[1.6rem] sm:col-span-2">
          <img src={heroMosaic[2].image} alt={heroMosaic[2].title} class="h-[22rem] w-full object-cover sm:h-[28rem]" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
            <p class="pill">Destacado</p>
            <h2 class="mt-3 text-3xl font-black text-white sm:text-4xl">Una marca visualmente más fuerte</h2>
          </div>
        </div>

        {heroMosaic.map((item) => (
          <article class="overflow-hidden rounded-[1.4rem] border border-white/10 bg-ink-950/30">
            <img src={item.image} alt={item.title} class="h-48 w-full object-cover transition duration-500 hover:scale-105" />
            <div class="space-y-1 p-4">
              <p class="text-xs font-black uppercase tracking-[0.28em] text-mint-300">{item.tag}</p>
              <p class="font-display text-xl font-black text-white">{item.title}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="catalogo" class="mt-16 space-y-8">
    <SectionHeading
      eyebrow="Catálogo"
      title="Productos destacados"
      description="Cada tarjeta tiene más respiración visual y mejor contraste para que el catálogo se sienta limpio, moderno y fácil de escanear."
    />

    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {featuredProducts.map((product) => (
        <ProductCard {...product} />
      ))}
    </div>
  </section>

  <section class="mt-16 grid gap-5 lg:grid-cols-3">
    {storeFeatures.map((feature) => (
      <FeatureCard {...feature} />
    ))}
  </section>

  <section class="mt-16 overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-r from-mint-400/15 via-white/5 to-sun-400/15 p-8 shadow-glow sm:p-10">
    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
      <div class="space-y-4">
        <span class="pill">Nueva base visual</span>
        <h2 class="text-3xl font-black text-white sm:text-4xl">Una tienda lista para crecer sin perder personalidad</h2>
        <p class="section-copy">
          Astro te deja servir páginas rápidas y claras, mientras Tailwind CSS acelera el diseño de una interfaz más elegante, coherente y fácil de mantener.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <article class="soft-card rounded-[1.5rem] p-5">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-sun-300">01</p>
          <p class="mt-2 font-display text-xl font-black text-white">Más contraste</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">La lectura mejora y la interfaz gana presencia inmediata.</p>
        </article>
        <article class="soft-card rounded-[1.5rem] p-5">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-sun-300">02</p>
          <p class="mt-2 font-display text-xl font-black text-white">Más orden</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">Cada bloque tiene una jerarquía más clara y consistente.</p>
        </article>
        <article class="soft-card rounded-[1.5rem] p-5">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-sun-300">03</p>
          <p class="mt-2 font-display text-xl font-black text-white">Más ritmo</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">Los fondos, brillos y bordes crean una composición más viva.</p>
        </article>
        <article class="soft-card rounded-[1.5rem] p-5">
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-sun-300">04</p>
          <p class="mt-2 font-display text-xl font-black text-white">Más escalable</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">La estructura ya está lista para crecer con componentes reales.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>
