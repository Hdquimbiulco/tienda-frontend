---
interface Props {
  title: string;
  price: string;
  image: string;
  tag: string;
}

const { title, price, image, tag } = Astro.props as Props;
const id = image.replace(/[^0-9]/g, '');
---

<article class="group overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 shadow-glow transition duration-300 hover:-translate-y-2 hover:border-mint-300/40">
  <a href={`/producto/?id=${id}&nombre=${encodeURIComponent(title)}&imagen=${encodeURIComponent(image)}`} class="block h-full">
    <div class="relative aspect-square overflow-hidden">
      <img src={image} alt={title} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/20 to-transparent"></div>
      <span class="absolute left-4 top-4 rounded-full border border-white/10 bg-ink-950/70 px-3 py-1 text-[0.65rem] font-black uppercase tracking-[0.35em] text-mint-300 backdrop-blur-md">{tag}</span>
    </div>
    <div class="space-y-2 p-5">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-2xl font-black text-white">{title}</h3>
        <span class="rounded-full bg-sun-400/15 px-3 py-1 text-sm font-black text-sun-300">${price}</span>
      </div>
      <p class="text-sm leading-6 text-slate-300">Una pieza visualmente más fuerte para que el catálogo se sienta moderno.</p>
    </div>
  </a>
</article>
