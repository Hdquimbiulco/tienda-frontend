---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props as Props;
---

<div class="max-w-3xl space-y-4">
  <p class="pill">{eyebrow}</p>
  <div class="space-y-3">
    <h2 class="text-3xl font-black text-white sm:text-4xl">{title}</h2>
    {description && <p class="section-copy">{description}</p>}
  </div>
</div>
