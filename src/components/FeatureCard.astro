---
interface Props {
  icon?: string;
  image?: string;
  title: string;
  description: string;
}

const { icon, image, title, description } = Astro.props as Props;
---

<article
  class:list={[
    'glass-surface flex h-full flex-col gap-4 rounded-[1.75rem] p-6',
    image && 'group items-center text-center transition-[transform,border-color,box-shadow] duration-300 hover:-translate-y-2 hover:border-mint-300/50 hover:shadow-[0_26px_70px_rgba(99,230,190,0.16)] sm:p-7'
  ]}
>
  {image ? (
    <div class="flex h-[7.5rem] w-[7.5rem] items-center justify-center rounded-[1.5rem] border border-white/15 bg-[radial-gradient(circle,rgba(99,230,190,0.18)_0%,rgba(255,255,255,0.03)_100%)] shadow-[0_12px_30px_rgba(0,0,0,0.3),inset_0_0_20px_rgba(99,230,190,0.12)] transition-[transform,background,border-color] duration-300 group-hover:-rotate-2 group-hover:scale-[1.08] group-hover:border-mint-300/50 group-hover:bg-[radial-gradient(circle,rgba(99,230,190,0.28)_0%,rgba(255,255,255,0.06)_100%)]">
      <img src={image} alt="" class="h-[5.95rem] w-[5.95rem] object-contain drop-shadow-[0_10px_18px_rgba(0,0,0,0.4)]" />
    </div>
  ) : (
    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-mint-400/15 text-sm font-black text-mint-300 ring-1 ring-inset ring-mint-300/20">{icon}</div>
  )}
  <div class:list={['space-y-2', image && 'mt-1']}>
    <h3 class="text-2xl font-black text-white">{title}</h3>
    <p class="text-sm leading-6 text-slate-300">{description}</p>
  </div>
</article>
